<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Patupi" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/patupi_gold</item>
        <item name="android:windowBackground">@color/patupi_bg</item>
        <item name="android:statusBarColor">@color/patupi_bg</item>

        <item name="colorOnBackground">@color/white</item>
        <item name="colorSurface">@color/patupi_bg</item>
        <item name="colorOnSurface">@color/white</item>

        <item name="materialAlertDialogTheme">@style/PatupiDialogTheme</item>
    </style>

    <style name="Theme.Patupi" parent="Base.Theme.Patupi" />

    <style name="PatupiDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/patupi_input_bg</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorPrimary">@color/patupi_gold</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/white</item>
    </style>

    <style name="RoundedCornersImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="PatupiLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="PatupiInputBox" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">18dp</item>
        <item name="boxBackgroundColor">@color/patupi_input_bg</item>
        <item name="boxStrokeColor">@color/patupi_input_stroke</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="startIconTint">@color/patupi_gold</item>
        <item name="endIconTint">@color/gray_text</item>
        <item name="hintEnabled">false</item>
        <item name="android:textColorHint">@color/gray_text</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:editTextColor">@color/white</item>
    </style>
</resources>